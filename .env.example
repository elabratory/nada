# ClipForge AI — copy this file to `.env.local` and fill in your keys.
#   cp .env.example .env.local

# REQUIRED — OpenAI key, used ONLY for speech-to-text (Whisper, word-level timestamps).
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# REQUIRED — Anthropic key, used to analyse the transcript, pick the best
# moments, and locate the speaker in frame for the vertical crop.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OPTIONAL — override the Claude model (default: claude-opus-5-5)
# CLAUDE_MODEL=claude-opus-5-5

# OPTIONAL — use your own FFmpeg binary instead of the bundled one (must include libass)
# FFMPEG_PATH=/usr/local/bin/ffmpeg
